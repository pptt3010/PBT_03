Phần chính:
*{
	box-sizing:border-box;
}

body{
	font-family:Arial;
	background:#f4f4f4;
	color:#333;
	line-height:1.6;
	margin:0;
}

header{
	background:linear-gradient(to right, blue, purple);
	color:white;
	padding:20px;
	text-align:center;
}

nav a{
	text-decoration:none;
	color:white;
	margin:0 10px;
}

nav a:hover{
	color:yellow;
	text-decoration:underline;
}

nav a.active{
	color:red;
	font-weight:bold;
}

table{
	width:100%;
	border-collapse:collapse;
}

th,td{
	border:1px solid #ccc;
	padding:10px;
}

th{
	background:#333;
	color:white;
}

tr:nth-child(even){
	background:#eee;
}

tr:hover{
	background:#ddd;
}

footer{
	background:#222;
	color:#aaa;
	text-align:center;
	padding:10px;
}
